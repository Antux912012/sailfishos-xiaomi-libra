+/dev/block/bootdevice/by-name/cache     /cache             ext4    nosuid,nodev,barrier=1                          wait,defaults
+/dev/block/bootdevice/by-name/cache     /cache             f2fs    rw,noatime,nosuid,nodev,inline_xattr            wait,defaults
 /dev/block/bootdevice/by-name/boot      /boot              emmc    defaults                                        defaults
